  --badge:#F5A524;
  --danger:#B3352F;
  --ok:#4FB05A;
  --blue:#4EA1E7;

  --r-card:26px;
  --r-ctl:18px;

  /* оттенки, которые меняются палитрой оформления */
  --seg-border:#D6D0DA;
  --hover:#F6F2F8;
  --tag-bg:#F5F1F8;
  --chip-on:#E4E0F1;
  --chip-hover:#F4F0F7;
