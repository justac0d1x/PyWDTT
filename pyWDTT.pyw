def _p256_jacobian_double(pt):
    x, y, z = pt
    p = _P256_P
    if y == 0 or z == 0:
        return (0, 1, 0)
    ysq = y * y % p
    s = 4 * x * ysq % p
    m = (3 * x * x + _P256_A * pow(z, 4, p)) % p
    nx = (m * m - 2 * s) % p
    ny = (m * (s - nx) - 8 * ysq * ysq) % p
    nz = 2 * y * z % p
    return (nx, ny, nz)

def _p256_jacobian_add(p1, p2):
    x1, y1, z1 = p1
    x2, y2, z2 = p2
    p = _P256_P
    if z1 == 0:
        return p2
    if z2 == 0:
        return p1
    z1sq = z1 * z1 % p
    z2sq = z2 * z2 % p
    u1 = x1 * z2sq % p
    u2 = x2 * z1sq % p
    s1 = y1 * z2sq * z2 % p
    s2 = y2 * z1sq * z1 % p
    if u1 == u2:
        if s1 != s2:
            return (0, 1, 0)
        return _p256_jacobian_double(p1)
    h = (u2 - u1) % p
    r = (s2 - s1) % p
    h2 = h * h % p
    h3 = h * h2 % p
    u1h2 = u1 * h2 % p
    nx = (r * r - h3 - 2 * u1h2) % p
    ny = (r * (u1h2 - nx) - s1 * h3) % p
    nz = h * z1 * z2 % p
    return (nx, ny, nz)

def _p256_scalarmult(k, point):
    p = _P256_P
    acc = (0, 1, 0)
    base = (point[0] % p, point[1] % p, 1)
    k %= _P256_N
    while k:
        if k & 1:
            acc = _p256_jacobian_add(acc, base)
        base = _p256_jacobian_double(base)
        k >>= 1
    x, y, z = acc
    if z == 0:
        return None
    zinv = pow(z, p - 2, p)
    zinv2 = zinv * zinv % p
    return (x * zinv2 % p, y * zinv2 * zinv % p)

def _p256_on_curve(x, y):
    return (y * y - (x * x * x + _P256_A * x + _P256_B)) % _P256_P == 0

